      "npmPackage": "@claude-plugins/chrome-devtools-mcp",
      "icon": "🔍",
      "mcp": {
        "command": "npx",
        "args": ["-y", "@claude-plugins/chrome-devtools-mcp"],
        "env": {
          "CDP_HOST": "localhost",
          "CDP_PORT": "9222"
        }
      },
      "requirements": ["Chrome with --remote-debugging-port=9222"],
